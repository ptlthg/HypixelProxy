{
	"name": "hypixel-proxy",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@10.34.5",
	"scripts": {
		"build": "tsdown",
		"check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
		"dev": "tsx watch src/index.ts",
		"format": "biome check --write .",
		"lint": "biome check .",
		"start": "node dist/index.js",
		"test": "tsx --test test/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@hono/node-server": "2.0.12",
		"hono": "4.12.32",
		"ipaddr.js": "2.4.0",
		"rate-limiter-flexible": "11.2.0",
		"smol-toml": "^1.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.7",
		"@types/node": "^24.9.1",
		"tsdown": "^0.22.7",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3"
	}
}
