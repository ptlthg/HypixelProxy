# The real key for this deployment's registered Hypixel application.
HYPIXEL_API_KEY=replace-with-the-real-project-key

# Leave empty to use the direct TCP peer. Only trust a header when the origin is restricted
# to the proxy that sets it. For Cloudflare, this can be CF-Connecting-IP.
FORWARDED_FOR_HEADER=

# Overall timeout for a request to api.hypixel.net, in milliseconds.
UPSTREAM_TIMEOUT_MS=30000

# Optional override for the User-Agent sent to Hypixel.
UPSTREAM_USER_AGENT=HypixelProxy/1.0
